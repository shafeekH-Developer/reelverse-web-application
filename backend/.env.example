# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file.

# Secret used to sign login tokens (use a long random string)
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Database (leave empty to use local SQLite; on hosting use a Postgres URL)
DATABASE_URL=

# Website address(es) allowed to call the API, comma separated
FRONTEND_ORIGIN=http://localhost:5173

# Email (verification codes) - any SMTP provider, e.g. Brevo
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-smtp-login
MAIL_PASSWORD=your-smtp-key
MAIL_DEFAULT_SENDER=you@example.com

# Cloudflare R2 (large video storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Cloudinary (images / thumbnails)
# Check backend/app/config.py for the exact variable names used
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
